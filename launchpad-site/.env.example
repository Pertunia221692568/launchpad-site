# ============ Copy this file to a new file called  .env  and fill it in (local use only) ============
# On Render you do NOT upload a .env file. You type these same names into Render > Environment.

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=launchpad_site
# Hosted MySQL (TiDB Cloud, Aiven, Railway...) needs an encrypted connection: set this to true there.
DB_SSL=false
# Only if your provider gives you a CA certificate (Aiven does). Paste it with \n instead of line breaks.
DB_SSL_CA=

# ---- Website ----
PORT=3000
# Local: http://localhost:3000   On Render: leave blank (Render's address is detected) or put your https URL.
SITE_URL=http://localhost:3000

# ---- Email (verification codes) ----
# BEST for going live: Brevo (sends over HTTPS, so it works on Render's free plan, to ANY recipient).
#   1) Sign up at brevo.com  2) Senders > add your email address and click the link Brevo emails you
#   3) SMTP & API > API keys > create a key   4) paste both lines below
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LaunchPad.dev
# Local-only alternative: Gmail + App Password. Gmail SMTP is BLOCKED on Render's free plan.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# With none of these set, codes are only printed in the terminal (local testing). Live sites refuse to sign people up instead.

# ---- Admin panel ----
# Comma-separated emails. Sign up with one of these (and verify it) and an "Admin Panel" item appears in your menu.
ADMIN_EMAILS=

# ---- Contact details (first-run defaults only; after that change them in the Admin Panel) ----
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_LOCATION=
CONTACT_HOURS=

# ---- Payments (Paystack) ----
# Put your Paystack SECRET key here (sk_test_... works for test payments with Paystack's test cards).
PAYSTACK_SECRET_KEY=
# Must be a currency your Paystack account supports (a South African Paystack account supports ZAR).
PAYSTACK_CURRENCY=ZAR
# With NO Paystack key, "true" lets the Pay button grant Pro without charging (class demo only).
DEMO_PAYMENTS=false

# ---- Optional ----
# A long random string. If empty, a new one is made each start (codes sent before a restart stop working).
APP_SECRET=
TRUST_PROXY=

# ---- Microsoft / Outlook sign-in ("Continue with Outlook") ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
